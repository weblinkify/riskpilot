# Copy to .env (gitignored) and adjust. Every value is optional – defaults run the full app.

# --- PostgreSQL (docker compose --profile real) ---
POSTGRES_DB=riskpilot
POSTGRES_USER=riskpilot
POSTGRES_PASSWORD=riskpilot

# --- Backend ---
# mock (deterministic rules engine, default) | llm (Claude via the Anthropic API)
ASSESSMENT_PROVIDER=mock
# Only needed when ASSESSMENT_PROVIDER=llm. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Frontend (npm scripts / Vercel build) ---
# mock = in-browser API, real = Java backend (via /graphql and /api proxy)
API_MODE=mock
# Optional absolute backend URL for real mode when not proxied (e.g. https://api.example.com)
API_BASE_URL=
